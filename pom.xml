<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.crop</groupId>
  <artifactId>retention-platform</artifactId>
  <version>1.1.0</version>
  <packaging>war</packaging>

  <name>Customer Retention Offer Platform</name>
  <description>Role-based platform for raising, approving and tracking customer retention offers</description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <selenium.version>4.27.0</selenium.version>
    <!-- The Selenium suite drives a throwaway instance started by this build on
         selenium.port. Jenkins overrides selenium.base.url to test a deployed server. -->
    <selenium.port>8095</selenium.port>
    <selenium.base.url>http://localhost:${selenium.port}</selenium.base.url>
    <selenium.headless>true</selenium.headless>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- provided: supplied by Tomcat when the WAR is deployed to a server -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-tomcat</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Selenium WebDriver. 4.x ships Selenium Manager, which resolves and downloads a
         matching chromedriver by itself, so no driver binary is committed or installed. -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>crop</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <!-- Start a throwaway instance for the Selenium suite and stop it afterwards,
               so `mvn verify` is self-contained and does not depend on someone having
               remembered to start the application first. -->
          <execution>
            <id>start-app-for-selenium</id>
            <goals><goal>start</goal></goals>
            <configuration>
              <arguments>
                <argument>--server.port=${selenium.port}</argument>
                <!-- a fresh database per run keeps the journeys deterministic -->
                <argument>--spring.datasource.url=jdbc:h2:file:${project.build.directory}/selenium-data/retention</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>stop-app-after-selenium</id>
            <goals><goal>stop</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- unit tests only; Selenium ITs run under failsafe -->
          <excludes><exclude>**/*IT.java</exclude></excludes>
        </configuration>
      </plugin>

      <!-- Failsafe runs the Selenium journeys in the integration-test phase, so
           `mvn test` stays fast and `mvn verify` is the full gate. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes><include>**/*IT.java</include></includes>
          <systemPropertyVariables>
            <selenium.base.url>${selenium.base.url}</selenium.base.url>
            <selenium.headless>${selenium.headless}</selenium.headless>
            <selenium.screenshot.dir>${project.build.directory}/selenium-screenshots</selenium.screenshot.dir>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Renders the failsafe XML into a browsable HTML report under target/reports. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-report-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
  </build>
</project>
