# ---------------------------------------------------------------------------
#  Customer Retention Offer Platform — reverse proxy
#  {{ ansible_managed }}
#  Do not edit by hand: change group_vars/all.yml and re-run the playbook.
#  No render timestamp here on purpose - it would change every run and the task
#  would report "changed" forever, hiding real drift.
# ---------------------------------------------------------------------------

server {
    listen       {{ crop_proxy_port }};
    server_name  localhost;

    access_log  {{ crop_logs_dir }}/nginx-access.log;
    error_log   {{ crop_logs_dir }}/nginx-error.log;

    # the WAR is ~61 MB; allow a generous body for future uploads
    client_max_body_size 64m;

    location / {
        proxy_pass         http://127.0.0.1:{{ crop_container_port }};
        proxy_http_version 1.1;

        proxy_set_header   Host              $host:$server_port;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_read_timeout    60s;
    }
}
